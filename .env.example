# Example environment configuration
# Copy this file to .env and fill in your values

# Network Configuration
PROVIDER_URL=http://127.0.0.1:8545
NETWORK_ID=1337

# Deployment Account
PRIVATE_KEY=your_private_key_here
DEPLOYER_ADDRESS=your_address_here

# Contract Addresses (fill after deployment)
TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
LENDING_PROTOCOL_ADDRESS=0x0000000000000000000000000000000000000000
ADVANCED_PROTOCOL_ADDRESS=0x0000000000000000000000000000000000000000

# Price Oracle Addresses (for Advanced Protocol)
ETH_USD_FEED=0x0000000000000000000000000000000000000000
BTC_USD_FEED=0x0000000000000000000000000000000000000000

# Protocol Configuration
MIN_COLLATERAL_RATIO=150
MAX_INTEREST_RATE=50
LIQUIDATION_BONUS=10

# API Keys (optional)
ETHERSCAN_API_KEY=your_etherscan_key
INFURA_PROJECT_ID=your_infura_id
ALCHEMY_API_KEY=your_alchemy_key

# Testing
TEST_NETWORK=ganache
TEST_MNEMONIC=test test test test test test test test test test test junk
